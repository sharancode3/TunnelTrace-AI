# ==============================================================================
# TunnelTrace AI — Local-First Environment Configuration Template
# Smart India Hackathon 2026 | NTRO Problem Statement 26160
# ==============================================================================
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT.
# DO NOT COMMIT THE REAL .env FILE OR STORE REAL CREDENTIALS IN VERSION CONTROL.
# ==============================================================================

# Application Runtime Configuration
APP_NAME="TunnelTrace AI"
APP_ENV="development"
APP_DEBUG=true
APP_HOST="127.0.0.1"
APP_PORT=8000
APP_LOG_LEVEL="INFO"
APP_SECRET_KEY="insecure-local-dev-secret-change-in-production-min32chars"

# Database Configuration (PostgreSQL 15+ with pgvector)
# Internal docker connection uses postgres host, local developer runs use 127.0.0.1
DATABASE_URL="postgresql+asyncpg://tunneltrace_user:tunneltrace_pass@127.0.0.1:5432/tunneltrace_db"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Redis Configuration (Transient Caching & Background Task Broker)
REDIS_URL="redis://127.0.0.1:6379/0"
REDIS_SOCKET_TIMEOUT=5.0
REDIS_MAX_CONNECTIONS=20

# Celery Worker Configuration
CELERY_BROKER_URL="redis://127.0.0.1:6379/0"
CELERY_RESULT_BACKEND="redis://127.0.0.1:6379/1"
CELERY_TASK_SERIALIZER="json"
CELERY_RESULT_SERIALIZER="json"
CELERY_ACCEPT_CONTENT=["json"]

# Local File & Artifact Storage Configuration
# Configurable root directory for non-DB storage (captures, temp files, reports)
STORAGE_ROOT="./storage"

# HTTP & CORS Security (Restricted local frontend origins by default)
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true

# Future Privileged Network Boundary (Stage 2+)
# Execution Class B agent is disabled by default in Stage 1
NETAGENT_ENABLED=false
NETAGENT_ENDPOINT="http://127.0.0.1:8001"

# Future Subsystem Paths (Placeholders for upcoming stages)
POLICIES_DIR="./policies/active"
MODELS_DIR="./models/active"
